configuration {
  modi: "drun";
  show-icons: true;
  font: "Iosevka Nerd Font 11";
  drun-display-format: "{icon} {name}";
}
* { bg: __BG__; bg-alt: __BG_ALT__; fg: __FG__; accent: __ACCENT__; }
window { width: 42%; background-color: @bg; border: 2px; border-color: @accent; border-radius: 12px; }
mainbox { background-color: transparent; padding: 14px; spacing: 9px; }
inputbar { background-color: @bg-alt; text-color: @fg; padding: 11px; border-radius: 8px; children: [prompt, entry]; }
prompt { background-color: transparent; text-color: @accent; padding: 0 9px 0 0; }
entry { background-color: transparent; text-color: @fg; }
listview { background-color: transparent; lines: 10; columns: 1; spacing: 5px; }
element { background-color: transparent; text-color: @fg; padding: 9px; border-radius: 7px; }
element selected { background-color: @bg-alt; text-color: @accent; }
element-icon { background-color: transparent; size: 1.6em; margin: 0 11px 0 0; }
element-text { background-color: transparent; text-color: inherit; }
