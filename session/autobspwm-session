#!/usr/bin/env sh
# Launch BSPWM with an isolated XDG configuration tree.
set -eu

base_config="$HOME/.config"
profile_pointer="$base_config/autobspwm/active-profile"
profile_name="$(sed -n '1p' "$profile_pointer" 2>/dev/null || true)"

case "$profile_name" in
  ''|*[!A-Za-z0-9_-]*)
    command -v notify-send >/dev/null 2>&1 && \
      notify-send 'AutoBspwm' 'No hay un perfil válido. Ejecuta install.sh.'
    exit 1
    ;;
esac

active_profile="$base_config/autobspwm/profiles/$profile_name"

if [ ! -x "$active_profile/bspwm/bspwmrc" ]; then
  command -v notify-send >/dev/null 2>&1 && \
    notify-send 'AutoBspwm' 'No hay un perfil instalado. Ejecuta install.sh.'
  exit 1
fi

export XDG_CONFIG_HOME="$active_profile"
export ZDOTDIR="$XDG_CONFIG_HOME/zsh"

# Keep application chrome at a conventional 96 DPI inside AutoBspwm. Kali's
# Xfce scaling can otherwise make GTK/Electron interfaces oversized in this
# lightweight session. Restore the X resource database when BSPWM exits so the
# normal Kali desktop remains untouched.
[ -r "$base_config/autobspwm/session.env" ] && \
  . "$base_config/autobspwm/session.env"
AUTOBSPWM_DPI="${AUTOBSPWM_DPI:-96}"
case "$AUTOBSPWM_DPI" in
  ''|*[!0-9]*) AUTOBSPWM_DPI=96 ;;
esac
AUTOBSPWM_CURSOR_SIZE="${AUTOBSPWM_CURSOR_SIZE:-24}"
case "$AUTOBSPWM_CURSOR_SIZE" in
  ''|*[!0-9]*) AUTOBSPWM_CURSOR_SIZE=24 ;;
esac
export GDK_SCALE=1
export GDK_DPI_SCALE=1
export QT_AUTO_SCREEN_SCALE_FACTOR=0
export QT_SCALE_FACTOR=1
export QT_FONT_DPI="$AUTOBSPWM_DPI"
export XCURSOR_SIZE="$AUTOBSPWM_CURSOR_SIZE"

xresources_backup=""
if command -v xrdb >/dev/null 2>&1; then
  xresources_backup="$(mktemp "${TMPDIR:-/tmp}/autobspwm-xresources.XXXXXX")"
  xrdb -query >"$xresources_backup" 2>/dev/null || :
  printf 'Xft.dpi: %s\nXcursor.size: %s\n' \
    "$AUTOBSPWM_DPI" "$AUTOBSPWM_CURSOR_SIZE" | xrdb -merge
fi

restore_xresources() {
  if [ -n "$xresources_backup" ] && [ -f "$xresources_backup" ]; then
    xrdb -load "$xresources_backup" 2>/dev/null || true
    rm -f -- "$xresources_backup"
  fi
}
trap restore_xresources EXIT HUP INT TERM

bspwm
